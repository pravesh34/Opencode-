<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OpenGateway" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A0F1E</item>
        <item name="android:colorAccent">#F2B6D6</item>
        <item name="android:statusBarColor">#1A0F1E</item>
        <item name="android:navigationBarColor">#1A0F1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Smooth transitions are applied in code via overridePendingTransition
             (fade_in_up / fade_out_up) to avoid AAPT windowAnimationStyle merge issues. -->
    </style>

    <!-- Kept for code references / lint; not wired as windowAnimationStyle to avoid AAPT merge. -->
    <style name="CodeGoWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in_up</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_up</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_up</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out_up</item>
    </style>
</resources>
